# =============================================================================
# Ghostty Terminal Configuration - Optimized for workhive
# =============================================================================
# Workflow: Claude Code + Lazygit + tmux + Git Worktrees
# Reference: https://ghostty.org/docs/config
# =============================================================================

# --- Section 1: Shell & Integration ---
# Enables path tracking, cursor feedback, and dynamic window titles
shell-integration = detect
shell-integration-features = title,cursor

# --- Section 2: Typography ---
# JetBrainsMono Nerd Font is essential for rendering workhive status icons
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-thicken = true
adjust-cell-height = 2
bold-is-bright = true

# --- Section 3: Appearance & Theme ---
# Using Catppuccin Mocha to match the workhive ecosystem
theme = Catppuccin Mocha
background-opacity = 0.9
background-blur-radius = 20

# Immersive UI settings for macOS
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
window-save-state = always
window-theme = auto

# --- Section 4: Input & Interaction ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8
mouse-hide-while-typing = true
copy-on-select = clipboard

# CRITICAL: Maps macOS Option key to Alt for tmux/vim navigation compatibility
macos-option-as-alt = true

# --- Section 5: AI Agent & Security ---
# Grants Claude Code and other AI tools permission to manage the clipboard
clipboard-read = allow
clipboard-write = allow

# Security layer to prevent malicious code execution during paste
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Section 6: Performance ---
# Massive scrollback buffer (25MB) for long AI coding and debugging sessions
scrollback-limit = 25000000

# --- Section 7: Quick Terminal (Quake Mode) ---
# Global dropdown terminal accessible via Ctrl+`
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Section 8: Keybindings ---

# [ Tabs Management ]
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# [ Native Splits Navigation ]
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# [ Font Scaling ]
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# [ System & Utility ]
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = cmd+shift+comma=reload_config
keybind = shift+enter=text:\n