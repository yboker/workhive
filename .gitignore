# ──────────────────────────────────────────────────
# Development & Debugging
# ──────────────────────────────────────────────────

# Test generated temporary files
test/tmp/
test/*.log

# Debug files
*.debug
debug.log
__pycache__/
*.py[cod]

# tmux debug logs (generated by tmux -v or -vv)
tmux-*.log
*.log

