# ──────────────────────────────────────────────────
# Secrets & Local Environment (DO NOT COMMIT)
# ──────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
*.local
*.secret
*.credentials
secrets/

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx

# ──────────────────────────────────────────────────
# Backups, Temporaries & Archives
# ──────────────────────────────────────────────────

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp

# Archives
*.zip
*.tar.gz
*.tgz

# Release packaging output
/dist/

# Node dependencies
/node_modules/

# Added by cargo

/target
/tmp
